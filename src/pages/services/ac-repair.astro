---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SEO from '../../components/SEO.astro';
import LocationHero from '../../components/LocationHero.astro';
import Footer from '../../components/Footer.astro'
import '@fontsource-variable/oswald';
import LocationSection from '../../components/LocationSection.astro';
import ServiceList from '../../components/ServiceList.astro';
import ServiceHighlightHero from '../../components/ServiceHighlightHero.astro';
import Promises from '../../components/Promises.astro';

---

<Layout>
  <SEO 
    slot="head"
    title="Air Conditioner Repair in Port Richey, FL | Farrell Air Conditioning"
    description="Looking for AC repair or installation in Port Richey, FL? Farrell Air Conditioning's delivers fast, reliable service to keep your home cool and comfortable all year long."
    canonical="https://farrellac.com/services/ac-repair-install"
    ogImage="/images/FAC.png"
    City="Port Richey"
    State="FL"
    services={["AC Repair", "AC Installation","Air Conditioner Repair","Air Conditioner Install"]}
  />



  <ServiceHighlightHero
    HeroTitle="Same Day AC Repair"
    HeroTitleTwo="in Port Richey, FL and Surrounding Areas"
  />

  <Promises/>

  <LocationSection 
  HeaderOne="#1-Rated AC Repair in Port Richey, FL"
  City="Port Richey"
  State="FL"
  ParaOne="There's nothing worse than your air conditioner quitting during a Florida heatwave, especially when you've got company or just want to relax at home. Unfortunately, AC breakdowns never seem to happen at a convenient time. At Farrell Air Conditioning, we understand how essential it is to restore your comfort quickly after an AC install or any air conditioner repair. A broken air conditioner in Port Richey or New Port Richey can lead to more than just discomfort; it can pose health risks from extreme heat, reduce your indoor air quality, and even cause moisture issues like mold growth."
  ParaSix="At Farrell Air Conditioning, we take pride in delivering top notch air conditioner repair services that cater to all your needs. Our certified technicians are available around the clock, ensuring you receive prompt assistance whenever your air conditioner fails. From residential setups to commercial units, we have the expertise to handle any AC repair job with ease."

  HeaderTwo="Quick Air Conditioner Repair"
  ParaTwo="Whether your AC goes out in the middle of the night or on a weekend, our team is just a call away. Farrell Air Conditioning offers 24-hour emergency air conditioner repair services throughout Port Richey, New Port Richey, and the surrounding areas. We've worked with all major brands and system types, so you can count on us for reliable air conditioner repair and swift diagnostics to get your system cooling again after an AC install."
  ParaFive="If you're dealing with a malfunctioning air conditioner, you don't have to suffer in the heat. Our quick air conditioner repair services in Port Richey mean you can get back to your comfort zone in no time. With competitive pricing and a commitment to quality, we aim to be your first choice when it comes to AC repair and maintenance."

  HeaderThree="Reliable Repair Solutions for Port Richey Climate"
  ParaThree="Even if your air conditioner hasn’t stopped completely, you might notice these warning signs that it’s struggling such as higher than usual electric bills, uneven cooling throughout your home, AC blowing warm air or weak airflow, odd smells or noises coming from your unit and short cycling (constantly turning on and off.)"
  ParaFour="Looking for reliable AC install and air conditioner repair solutions? Look no further! Our team at Farrell Air Conditioning offers seamless AC installations and dependable air conditioner repairs tailored to your specific requirements. We utilize energy-efficient systems to help lower your utility bills, ensuring that you enjoy a cool home without breaking the bank."
/>

 
 <div class="flex flex-col items-center justify-center my-10">
  <button
    class="bg-[#08439d] text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition"
    onclick="loadMap()"
  >
    View Map to Farrell Air Conditioning
  </button>

  <div id="map-container" class="w-full flex justify-center mt-4"></div>
</div>

<script is:inline>
  function loadMap() {
    const mapContainer = document.getElementById('map-container');
    mapContainer.innerHTML = `
      <iframe
        loading="lazy"
        class="mx-auto"
        width="400"
        height="300"
        style="border:0;"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3513.625157122426!2d-82.70369042298879!3d28.279380800027273!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88c2907ab37ad2dd%3A0xa964f7b5a6c01832!2sFarrell%20Air%20Conditioning!5e0!3m2!1sen!2sus!4v1748360517939!5m2!1sen!2sus">
      </iframe>`;
  }
</script>
</Layout>

