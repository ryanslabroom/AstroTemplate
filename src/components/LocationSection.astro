---
const {
  HeaderOne, City, State,
  ParaOne, ParaTwo, ParaThree,
  ParaFour, ParaFive, ParaSix,
  HeaderTwo, HeaderThree
} = Astro.props
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 px-4 md:px-20 mx-auto my-10">
  <div class="order-1 md:order-1 space-y-12">
    
    <section>
      <h2 class="text-4xl text-[#08439d] font-bold text-left mb-4">{HeaderOne}</h2>
      <p class="text-xl leading-relaxed text-gray-700 mb-6">{ParaOne}</p>
      <p class="text-xl leading-relaxed text-gray-700">{ParaSix}</p>
    </section>

    <section>
      <h2 class="text-4xl text-[#08439d] font-bold text-left mb-4">{HeaderTwo} in {City}, {State}</h2>
      <p class="text-xl leading-relaxed text-gray-700 mb-6">{ParaTwo}</p>
      <p class="text-xl leading-relaxed text-gray-700">{ParaFive}</p>
    </section>

    <section>
      <h2 class="text-4xl text-[#08439d] font-bold text-left mb-4">{HeaderThree}</h2>
      <p class="text-xl leading-relaxed text-gray-700 mb-6">{ParaThree}</p>
      <p class="text-xl leading-relaxed text-gray-700">{ParaFour}</p>
    </section>

  </div>

  <aside class="order-2 md:order-2 flex justify-center" aria-label="Booking Form">
    <script async src="https://online-booking.housecallpro.com/script.js?token=e04a9346c2b64d92b5b0e60598d17b63&orgName=Farrell-Air-Conditioning"></script>
    <iframe
      loading="lazy"
      style="background-color: white;"
      id="hcp-lead-iframe"
      width="500px"
      src="https://book.housecallpro.com/lead-form/Farrell-Air-Conditioning/e04a9346c2b64d92b5b0e60598d17b63"
    ></iframe>
    
  </aside>
  
</div>
