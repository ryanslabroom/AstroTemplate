---
import { Image } from 'astro:assets';
const {Service, Location} = Astro.props;
---

<section class="hero-section relative flex justify-center items-center px-4 min-h-[60vh]"> 
  <!-- Optional overlay -->
  <div class="absolute inset-0 bg-black/20 z-0 border-b-2 border-blue-500"></div>

  <div class="relative w-full text-center px-4 z-10">
    <h1 class="text-white font-extrabold drop-shadow-lg leading-tight 
                text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl 2xl:text-8xl">
      {Service} <br /> {Location}
    </h1>
  </div>
</section>

<style>
.hero-section {
  background-image: url("/images/HeroIMG.webp");
  background-size: cover;
  background-position: center;
}
</style>